{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TrislabCompany/tl-platform/stamps/aca-app/stamp.schema.json",
  "title": "stamp.yaml of aca-app v1.0.0",
  "description": "06-stamp-templates.md sections 3.1 and 3.3 of tl-cloud-infrastructure. v1.0.0 has the Consumption profile only, no zone redundancy and no backing services (section 8).",
  "type": "object",
  "additionalProperties": false,
  "required": ["template", "version", "lz", "product", "environment", "tenancy", "network", "apps"],
  "properties": {
    "template": { "const": "aca-app" },
    "version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "lz": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "product": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "environment": { "type": "string", "pattern": "^(dev|test|uat|perf|demo|staging|prod|pr[1-9][0-9]*)$" },
    "number": { "type": "string", "pattern": "^(0[1-9]|[1-9][0-9])$" },
    "tenancy": { "enum": ["shared", "dedicated"] },
    "zone_redundant": { "const": false },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subnet_cidr"],
      "properties": {
        "subnet_cidr": { "type": "string", "pattern": "^10\\.([0-9]{1,3}\\.){2}[0-9]{1,3}/(1[2-9]|2[0-7])$" }
      }
    },
    "app_environment": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "ttl": { "type": "string", "pattern": "^[1-9][0-9]*[hd]$" },
    "apps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "repo", "profile", "caps"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]{1,9}$",
            "not": { "enum": ["postgres", "cache", "messaging", "storage", "search"] }
          },
          "repo": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "profile": { "const": "Consumption" },
          "ingress": { "enum": ["external", "internal", "none"] },
          "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "caps": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cpu", "memory", "max_replicas"],
            "properties": {
              "cpu": { "type": "number", "exclusiveMinimum": 0, "maximum": 4 },
              "memory": { "type": "string", "pattern": "^([1-8]|0\\.[0-9]+|[1-7]\\.[0-9]+)Gi$" },
              "max_replicas": { "type": "integer", "minimum": 1, "maximum": 300 },
              "profiles": {
                "type": "array",
                "items": { "const": "Consumption" },
                "minItems": 1,
                "maxItems": 1
              }
            }
          },
          "secrets": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$",
              "not": { "anyOf": [{ "const": "ghcr-pull" }, { "pattern": "^origin-" }] }
            }
          },
          "env": {
            "type": "object",
            "propertyNames": { "pattern": "^(?!PLATFORM_)[A-Z_][A-Z0-9_]*$" },
            "additionalProperties": { "type": "string" }
          }
        },
        "if": { "properties": { "ingress": { "const": "none" } }, "required": ["ingress"] },
        "then": { "not": { "required": ["port"] } },
        "else": { "required": ["port"] }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "environment": { "pattern": "^pr[1-9][0-9]*$" } } },
      "then": { "required": ["ttl"] }
    }
  ]
}
